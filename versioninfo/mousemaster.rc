// Version information for mousemaster.exe.
// Without it, the executable has no VERSIONINFO resource of its own and Windows falls back
// to the one of the VCRUNTIME140.dll that pefrmdllembed embeds: Task Manager's Processes tab
// then lists mousemaster as "Microsoft(R) C Runtime Library", which makes a running instance
// impossible to find.
// GraalVM native-image has no option for this, so compile.ps1 compiles this file and pom.xml
// hands the result to the linker with -H:NativeLinkerOption.
// mousemaster-version.h is generated by compile.ps1 from the Maven version.

#include "mousemaster-version.h"

1 VERSIONINFO // 1 is VS_VERSION_INFO.
FILEVERSION MOUSEMASTER_VERSION, 0, 0, 0
PRODUCTVERSION MOUSEMASTER_VERSION, 0, 0, 0
FILEOS 0x4L // VOS__WINDOWS32
FILETYPE 0x1L // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0" // U.S. English, Unicode.
        {
            VALUE "FileDescription", "mousemaster"
            VALUE "FileVersion", MOUSEMASTER_VERSION_STRING
            VALUE "InternalName", "mousemaster"
            VALUE "OriginalFilename", "mousemaster.exe"
            VALUE "ProductName", "mousemaster"
            VALUE "ProductVersion", MOUSEMASTER_VERSION_STRING
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 0x4b0
    }
}
